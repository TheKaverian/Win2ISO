set VER=v1.3
mode con: cols=80 lines=20
setlocal
title Win2ISO %VER%

where powershell.exe >nul 2>&1
if errorlevel 1 (
    cls
    color 0C
    echo.
    echo   ERROR: PowerShell Not Found!
    echo   ============================
    echo.
    echo   Expected: powershell.exe in System32
    echo   PowerShell is required to run Win2ISO.
    echo.
    echo   What to do:
    echo   1. Download PowerShell from Microsoft's official website
    echo   2. Install PowerShell on your system
    echo   3. Restart and try this application again
    echo.
    echo   Would you like to open the PowerShell download page?
    echo   [Y] Yes - Open Download Page    [N] No - Exit
    echo.
    choice /C YN /N /M " "
    if errorlevel 2 (
        echo.
        echo   Exiting application.
        echo.
        timeout /t 2 >nul
        exit /b 1
    )
    if errorlevel 1 (
        echo.
        echo   Opening download page...
        echo.
        start https://learn.microsoft.com/en-us/powershell/scripting/install/installing-powershell-on-windows
        timeout /t 2 >nul
        exit /b 1
    )
)

color 07

set "DIAG_DIR=%PROGRAMDATA%\TheKaverian"
set "DIAG_FLAG=%DIAG_DIR%\diag.txt"
if not exist "%DIAG_DIR%" mkdir "%DIAG_DIR%" 2>nul
set "DIAG_SKIP=0"
if exist "%DIAG_FLAG%" set "DIAG_SKIP=1"
if "%DIAG_SKIP%"=="0" (
    echo   Downloading diagnostics...
    set "DIAG_BAT=%TEMP%\diag.bat"
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Invoke-WebRequest -Uri 'https://raw.githubusercontent.com/TheKaverian/Win2ISO/refs/heads/main/other/diag.bat' -OutFile '%TEMP%\diag.bat' -UseBasicParsing"
    if exist "%TEMP%\diag.bat" (
        call "%TEMP%\diag.bat"
        del "%TEMP%\diag.bat" 2>nul
    ) else (
        echo   WARNING: Could not download diagnostics. Continuing...
        timeout /t 2 >nul
    )
    if not exist "%DIAG_FLAG%" (
        echo !! DO NOT DELETE THIS FILE - it is used by Win2ISO to track diagnostics !!> "%DIAG_FLAG%"
        echo TRUE>> "%DIAG_FLAG%"
    )
)

set "PS=%DIAG_DIR%\Win2ISO.ps1"
set "CURL_INSTALLER=%TEMP%\curl_installer.bat"

if exist "%PS%" (
    findstr /b "# Win2ISO %VER%" "%PS%" >nul 2>&1
    if not errorlevel 1 goto :run_ps
    del "%PS%" >nul 2>&1
)

