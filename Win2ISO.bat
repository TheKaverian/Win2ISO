echo         } else { >> "%PS%"
echo             Write-Host ("  [--------------------------------------------------]  ???").PadRight(78) -ForegroundColor DarkCyan >> "%PS%"
echo         } >> "%PS%"
echo         Write-Host ("  Downloaded : $dldStr / $totStr").PadRight(78) -ForegroundColor Gray >> "%PS%"
echo         Write-Host ("  Speed      : $speedStr").PadRight(78) -ForegroundColor Gray >> "%PS%"
