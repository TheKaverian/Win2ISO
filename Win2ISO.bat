echo     if (-not $downloadCancelled) { $proc.WaitForExit() } >> "%PS%"
echo. >> "%PS%"

rem --- final frame: show 100%% or last known state ---
echo     if (-not $downloadCancelled -and $proc.ExitCode -eq 0) { >> "%PS%"
echo         [Console]::SetCursorPosition(0, $progressRow) >> "%PS%"
echo         if ($totalBytes -gt 0) { >> "%PS%"
echo             $bar = '[' + ('#' * 50) + ']' >> "%PS%"
echo             Write-Host ("  $bar  100%%").PadRight(78) -ForegroundColor Green >> "%PS%"
echo             $totFmt = Format-Bytes2 $totalBytes >> "%PS%"
echo             Write-Host ("  Downloaded : $totFmt / $totFmt").PadRight(78) -ForegroundColor Green >> "%PS%"
echo         } else { >> "%PS%"
echo             Write-Host '  [##################################################]  Done!'.PadRight(78) -ForegroundColor Green >> "%PS%"
echo             Write-Host '  Downloaded successfully.'.PadRight(78) -ForegroundColor Green >> "%PS%"
echo         } >> "%PS%"
echo         Write-Host '  Speed      : Done!'.PadRight(78) -ForegroundColor Green >> "%PS%"
echo         Write-Host '  ETA        : Complete!'.PadRight(78) -ForegroundColor Green >> "%PS%"
echo     } >> "%PS%"
echo     [Console]::CursorVisible = $false >> "%PS%"
echo     Write-Host "" >> "%PS%"
echo     if ($downloadCancelled) { >> "%PS%"
