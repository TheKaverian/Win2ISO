echo     if ($eds[$e] -like '*8.1 Pro [RTM]*') { >> "%PS%"
echo         Write-Host "" >> "%PS%"
echo         Write-Host "  Product Key: XHQ8N-C3MCJ-RQXB6-WCHYG-C9WKB" -ForegroundColor Cyan >> "%PS%"
