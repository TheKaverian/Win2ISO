echo Clear-Host >> "%PS%"
echo Write-Host "" >> "%PS%"
echo Write-Host "  Thanks for using Win2ISO!" -ForegroundColor Green >> "%PS%"
echo Write-Host "  Goodbye." -ForegroundColor DarkGray >> "%PS%"
echo Write-Host "" >> "%PS%"
echo [Console]::CursorVisible = $true >> "%PS%"
