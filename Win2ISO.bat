echo     Write-Host ('  ' + ' '.PadRight(76)) >> "%PS%"
echo     Write-Host ('  ' + ' '.PadRight(76)) >> "%PS%"
echo     Write-Host ('  ' + ' '.PadRight(76)) >> "%PS%"
echo. >> "%PS%"

echo     while (-not $proc.HasExited) { >> "%PS%"
echo         $now          = [DateTime]::Now >> "%PS%"
echo         $curBytes     = 0 >> "%PS%"
echo         if (Test-Path $out) { try { $curBytes = (Get-Item $out -ErrorAction Stop).Length } catch {} } >> "%PS%"
echo         $speedElapsed = ($now - $lastSpeedTime).TotalSeconds >> "%PS%"
echo         if ($speedElapsed -ge 1) { >> "%PS%"
echo             $speedBps      = ($curBytes - $lastBytes) / $speedElapsed >> "%PS%"
echo             $lastBytes     = $curBytes >> "%PS%"
echo             $lastSpeedTime = $now >> "%PS%"
echo         } >> "%PS%"
echo         $pct    = if ($totalBytes -gt 0) { [Math]::Min(100,[int](($curBytes / $totalBytes) * 100)) } else { -1 } >> "%PS%"
echo         $etaStr = 'Calculating...' >> "%PS%"
echo         if ($speedBps -gt 0 -and $totalBytes -gt 0 -and $curBytes -lt $totalBytes) { >> "%PS%"
echo             $etaSec = [int](($totalBytes - $curBytes) / $speedBps) >> "%PS%"
echo             $etaH   = [int]($etaSec / 3600) >> "%PS%"
echo             $etaM   = [int](($etaSec %% 3600) / 60) >> "%PS%"
echo             $etaS   = $etaSec %% 60 >> "%PS%"
echo             if     ($etaH -gt 0) { $etaStr = "$($etaH)h $($etaM)m $($etaS)s" } >> "%PS%"
echo             elseif ($etaM -gt 0) { $etaStr = "$($etaM)m $($etaS)s" } >> "%PS%"
echo             else                 { $etaStr = "$($etaS)s" } >> "%PS%"
echo         } elseif ($speedBps -le 0 -and $curBytes -eq 0) { $etaStr = 'Connecting...' } >> "%PS%"
echo         $speedStr = if ($speedBps -gt 0) { (Format-Bytes2 $speedBps) + '/s' } else { '---' } >> "%PS%"
echo         $dldStr   = Format-Bytes2 $curBytes >> "%PS%"
echo         $totStr   = if ($totalBytes -gt 0) { Format-Bytes2 $totalBytes } else { '???' } >> "%PS%"
echo. >> "%PS%"

echo         [Console]::SetCursorPosition(0, $progressRow) >> "%PS%"
echo         if ($pct -ge 0) { >> "%PS%"
echo             $filled = [int](($pct / 100) * 50) >> "%PS%"
