echo. >> "%PS%"

echo     $startTime    = [DateTime]::Now >> "%PS%"
echo     $lastBytes    = 0 >> "%PS%"
echo     $lastSpeedTime = $startTime >> "%PS%"
echo     $speedBps     = 0 >> "%PS%"
echo. >> "%PS%"
rem --- draw static header on a clean screen, then lock the cursor row ---
echo     Clear-Host >> "%PS%"
echo     [Console]::CursorVisible = $false >> "%PS%"
echo     $sizeLabel = if ($totalBytes -gt 0) { Format-Bytes2 $totalBytes } else { 'Unknown' } >> "%PS%"
echo     Write-Host '' >> "%PS%"
echo     Write-Host '  Win2ISO - Downloading ISO' -ForegroundColor Green >> "%PS%"
echo     Write-Host '  =========================' -ForegroundColor DarkGreen >> "%PS%"
echo     Write-Host '' >> "%PS%"
echo     Write-Host "  Edition : $($eds[$e])" -ForegroundColor Yellow >> "%PS%"
echo     Write-Host "  Arch    : $arch" -ForegroundColor Yellow >> "%PS%"
echo     Write-Host "  Size    : $sizeLabel" -ForegroundColor DarkGray >> "%PS%"
echo     Write-Host "  Saving  : $out" -ForegroundColor DarkGray >> "%PS%"
echo     Write-Host '' >> "%PS%"
